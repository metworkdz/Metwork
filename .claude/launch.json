{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metwork",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "metwork-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "metwork-localdb",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3999,
      "env": {
        "USE_LOCAL_DB": "true",
        "API_INTERNAL_URL": "http://localhost:3999/api"
      }
    },
    {
      "name": "metwork-e2e",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3000,
      "env": {
        "USE_LOCAL_DB": "true",
        "API_INTERNAL_URL": "http://localhost:3000/api",
        "PAYMENT_PROVIDER": "mock",
        "MOCK_PAYMENT_MODE": "sync",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3000"
      }
    },
    {
      "name": "metwork-demo-shots",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev"
      ],
      "port": 3000,
      "env": {
        "USE_LOCAL_DB": "true",
        "API_INTERNAL_URL": "http://localhost:3000/api",
        "PAYMENT_PROVIDER": "mock",
        "MOCK_PAYMENT_MODE": "sync",
        "RESEND_API_KEY": "",
        "INFOBIP_API_KEY": "",
        "INFOBIP_BASE_URL": "",
        "INFOBIP_SENDER": "",
        "INFOBIP_WHATSAPP_SENDER": ""
      }
    },
    {
      "name": "metwork-academy",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3998"
      ],
      "port": 3998,
      "env": {
        "USE_LOCAL_DB": "true",
        "API_INTERNAL_URL": "http://localhost:3998/api",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3998",
        "NEXT_PUBLIC_ACADEMY_PREVIEW": "true",
        "ACADEMY_VIDEO_PROVIDER": "mock",
        "SMS_PROVIDER": "mock"
      }
    }
  ]
}
