{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metwork",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "metwork-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "metwork-localdb",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3999,
      "env": {
        "USE_LOCAL_DB": "true",
        "API_INTERNAL_URL": "http://localhost:3999/api"
      }
    }
  ]
}
