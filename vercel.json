{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-credits",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/credit-expiry-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/expire-promo-codes",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-downgrades",
      "schedule": "0 1 * * *"
    }
  ]
}
