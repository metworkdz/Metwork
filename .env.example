# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Metwork
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ─────────────────────────────────────────────
# API (NestJS backend — to be deployed separately)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000

# ─────────────────────────────────────────────
# Database (Postgres)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://metwork:metwork@localhost:5432/metwork?schema=public"

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_COOKIE_NAME=metwork_session
AUTH_COOKIE_DOMAIN=localhost
# Internal server-to-server secret — required for /api/wallet/payments
INTERNAL_API_SECRET=   # Required: generate with: openssl rand -base64 32
# Cron job authentication secret — required for /api/cron/* endpoints
CRON_SECRET=           # Required: generate with: openssl rand -base64 32

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# File storage (MinIO / S3-compatible)
# ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=metwork-uploads
S3_PUBLIC_URL=http://localhost:9000/metwork-uploads

# ─────────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Metwork <noreply@metwork.dz>"

# OTP delivery — WhatsApp (primary) and SMS (fallback) via Infobip
# Set SMS_PROVIDER=infobip and fill the three vars below to send real messages.
# Leave SMS_PROVIDER=mock (default) to print codes to the server console.
SMS_PROVIDER=infobip
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
# WhatsApp requires a WABA-approved sender (different from SMS). Get it from
# Infobip portal → Channels → WhatsApp. Falls back to INFOBIP_SENDER if unset,
# but WhatsApp will reject non-WABA numbers (REJECTED_SOURCE error).
INFOBIP_WHATSAPP_SENDER=
# Business-initiated WhatsApp OTP needs an approved Meta AUTHENTICATION template.
# Name + language must EXACTLY match the approved template (language e.g. en_GB, en_US).
INFOBIP_WHATSAPP_OTP_TEMPLATE=metwork_otp
INFOBIP_WHATSAPP_OTP_LANG=en_GB

# ─────────────────────────────────────────────
# Payment provider (abstracted via PaymentProvider interface)
#   mock     — local-only, settles synchronously; flip to async via
#              MOCK_PAYMENT_MODE=async to exercise the webhook path
#   slickpay — Algerian processor (CIB / Edahabia hosted checkout)
#   cib / edahabia — direct integrations (not implemented yet)
# ─────────────────────────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
MOCK_PAYMENT_MODE=sync

# Feature flag: instant-book, pay-first consultations (no admin approval).
# 'false' (default) keeps the legacy admin-approval flow; the /instant-book
# routes 404 until this is 'true'.
CONSULTATION_INSTANT_BOOK=false

# SlickPay — required when PAYMENT_PROVIDER=slickpay
SLICKPAY_PUBLIC_KEY=
SLICKPAY_SECRET_KEY=
SLICKPAY_WEBHOOK_SECRET=
SLICKPAY_API_BASE=https://prod.slick-pay.com/api/v2

# ─────────────────────────────────────────────
# Cloudinary (image uploads — optional, falls back to local filesystem)
# Sign up at https://cloudinary.com and copy from Dashboard → API Keys
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
